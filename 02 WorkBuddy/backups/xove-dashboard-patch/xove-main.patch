+    /** 统计指定文件夹（留空=整个库）下所有 md 的字数：中文按字计、英文按词计。
+     *  分批并发读取，避免上千个 Promise 一次性占满微任务队列。 */
+    async countWordsInFolder(folder) {
+        const prefix = (folder || '').trim().replace(/\/+$/, '');
+        const files = this.app.vault.getMarkdownFiles().filter((f) => {
+            // 排除依赖目录，避免第三方库里的 md 把字数统计严重放大
+            if (f.path.includes('node_modules/'))
+                return false;
+            if (!prefix || prefix === '/')
+                return true;
+            return f.path === prefix || f.path.startsWith(prefix + '/');
+        });
+        let total = 0;
+        const BATCH = 100;
+        for (let i = 0; i < files.length; i += BATCH) {
+            const chunk = files.slice(i, i + BATCH);
+            const counts = await Promise.all(chunk.map(async (f) => {
+                try {
+                    const raw = await this.app.vault.cachedRead(f);
+                    const body = raw.replace(/^---\r?\n[\s\S]*?\r?\n---\r?\n?/, '');
+                    const cjk = (body.match(/[\u4e00-\u9fa5]/g) || []).length;
+                    const en = (body.replace(/[\u4e00-\u9fa5]/g, ' ').match(/[A-Za-z0-9]+/g) || []).length;
+                    return cjk + en;
+                }
+                catch (e) {
+                    return 0;
+                }
+            }));
+            for (const n of counts)
+                total += n;
+        }
+        return total;
+    }
+    /** 刷新「自动统计」类目标：先套用持久缓存立即出结果，过期项交给后台重算。 */
+    async refreshAutoGoals(goals, onUpdated, commit) {
+        const auto = goals.filter((g) => g.auto === 'wordcount');
+        if (!auto.length)
+            return;
+        const cache = (this.plugin.settings.wcCache = this.plugin.settings.wcCache || {});
+        const now = Date.now();
+        let changed = false;
+        const stale = [];
+        for (const g of auto) {
+            const key = g.folder || '/';
+            const hit = cache[key];
+            if (!hit) {
+                stale.push(g);
+                continue;
+            }
+            if (hit.n !== g.current) {
+                g.current = hit.n;
+                changed = true;
+            }
+            if (now - hit.at > WC_TTL)
+                stale.push(g);
+        }
+        if (changed) {
+            if (commit)
+                await commit();
+            if (onUpdated)
+                onUpdated();
+        }
+        if (stale.length)
+            void this.recomputeWordCounts(stale, goals, cache, onUpdated, commit);
+    }
+    /** 后台重算（不阻塞首屏）：算完再回写并局部刷新。 */
+    async recomputeWordCounts(list, goals, cache, onUpdated, commit) {
+        let changed = false;
+        for (const g of list) {
+            const key = g.folder || '/';
+            const n = await this.countWordsInFolder(g.folder);
+            cache[key] = { at: Date.now(), n };
+            if (n !== g.current) {
+                g.current = n;
+                changed = true;
+            }
+        }
+        if (!changed)
+            return;
+        if (commit)
+            await commit();
+        else {
+            this.plugin.settings.goals = goals.map((g) => ({ ...g }));
+            await this.plugin.saveSettings();
+        }
+        if (onUpdated)
+            onUpdated();
+    }
