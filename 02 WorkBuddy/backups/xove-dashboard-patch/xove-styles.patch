+/* ===== 目标进度：新增目标 + 目标编辑弹窗 ===== */
+.ad-goal__add { display: flex; justify-content: center; padding-top: 2px; }
+.ad-goal__addbtn {
+  padding: 5px 14px; border: 1px dashed var(--ad-line); border-radius: var(--ad-r2);
+  background: transparent; color: var(--ad-text-mute);
+  font-family: var(--ad-font); font-size: 12px; cursor: pointer; transition: border-color .12s, color .12s;
+}
+.ad-goal__addbtn:hover { border-color: var(--ad-accent); color: var(--ad-accent); }
+.ad-gform { display: flex; flex-direction: column; gap: 10px; }
+.ad-gform__row { display: flex; align-items: center; gap: 10px; }
+.ad-gform__row > label { flex: 0 0 68px; font-family: var(--ad-font); font-size: 12px; color: var(--ad-text-mute); }
+.ad-gform__row .ad-modal-input { flex: 1; min-width: 0; }
+.ad-gform__icon { flex: 0 0 64px !important; text-align: center; }
+.ad-gform__color { flex: 0 0 48px !important; height: 28px; padding: 2px; cursor: pointer; }
+.ad-gform__btns { display: flex; justify-content: flex-end; gap: 10px; margin-top: 14px; }
+.ad-gform__btns button {
+  padding: 7px 18px; border-radius: var(--ad-r2); border: 1px solid var(--ad-line);
+  background: var(--ad-s2); color: var(--ad-text);
+  font-family: var(--ad-font); font-size: 13px; cursor: pointer;
+}
+.ad-gform__btns button.mod-cta { background: var(--ad-accent); border-color: var(--ad-accent); color: var(--ad-on-accent); }
+
+/* ===== 新建页：一级创建入口（日记 / 任务 / 项目） ===== */
+.im-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(196px, 1fr));
+  gap: 12px;
+}
+.im-card {
+  display: flex; flex-direction: column; gap: 6px;
+  padding: 16px;
+  background: var(--ad-s1);
+  border: 1px solid var(--ad-line);
+  border-radius: var(--ad-r3);
+  cursor: pointer;
+  transition: border-color .18s ease, background .18s ease, transform .18s ease;
+}
+.im-card:hover { border-color: var(--ad-accent); background: var(--ad-s2); }
+.im-card:focus-visible { outline: 2px solid var(--ad-accent); outline-offset: 2px; }
+.im-card:active { transform: translateY(1px); }
+.im-card__icon { width: 22px; height: 22px; color: var(--ad-accent); flex: 0 0 auto; }
+.im-card__icon svg { width: 100%; height: 100%; display: block; }
+.im-card__title { font-family: var(--ad-font); font-size: 14px; font-weight: 600; color: var(--ad-text); }
+.im-card__desc { font-family: var(--ad-font); font-size: 11.5px; line-height: 1.5; color: var(--ad-text-mute); }
+
+/* 日记内联输入区（点「新建日记」展开） */
+.im-diary {
+  display: flex; flex-direction: column; gap: 10px;
+  padding: 14px;
+  background: var(--ad-s1);
+  border: 1px solid var(--ad-line);
+  border-radius: var(--ad-r3);
+}
+.im-diary.is-hidden { display: none; }
+.im-diary__area { width: 100%; min-height: 68px; resize: vertical; font-family: var(--ad-font); }
+.im-diary__row { display: flex; gap: 10px; justify-content: flex-end; }
+.im-diary__row .im-btn:not(.im-btn--primary) {
+  background: transparent; border-color: var(--ad-line); color: var(--ad-text-mute);
+}
+.im-diary__row .im-btn:not(.im-btn--primary):hover { border-color: var(--ad-accent); color: var(--ad-accent); }
+
+/* 次要区块：映射已有笔记（折叠，展开才加载文件列表） */
+.im-section { border: 1px solid var(--ad-line); border-radius: var(--ad-r3); }
+.im-section__head { display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; }
+.im-section__title { font-family: var(--ad-font); font-size: 13px; font-weight: 600; color: var(--ad-text); }
+.im-section__toggle {
+  padding: 4px 12px; border: 1px solid var(--ad-line); border-radius: var(--ad-r2);
+  background: transparent; color: var(--ad-text-mute);
+  font-family: var(--ad-font); font-size: 12px; cursor: pointer;
+  transition: color .18s ease, border-color .18s ease;
+}
+.im-section__toggle:hover { color: var(--ad-accent); border-color: var(--ad-accent); }
+.im-section__toggle:focus-visible { outline: 2px solid var(--ad-accent); outline-offset: 1px; }
+.im-section__body { padding: 0 16px 16px; }
+.im-section__body.is-hidden { display: none; }
+
+/* 尊重系统「减少动态效果」设置 */
+@media (prefers-reduced-motion: reduce) {
+  .im-card, .im-section__toggle, .im-btn, .im-item__del { transition: none; }
+  .im-card:active { transform: none; }
+}
+
+/* ===== 自定义面板 ===== */
+/* 面板页：内容卡占满容器宽度（复用 .ad-b-mirror 的原生渲染样式） */
+.im-container .ad-panel__card { width: 100%; display: block; }
+/* 新建面板表单：图标 + 名称一行 */
+.im-panel__fields { justify-content: flex-start; }
+.im-panel__fields .im-input--icon { flex: 0 0 64px; }
+.im-panel__fields .im-input { flex: 1; min-width: 0; }
+/* 我的面板：排序/删除按钮 */
+.im-panels__btns { display: flex; gap: 4px; margin-left: auto; flex: 0 0 auto; }
+.im-panels__btn {
+  width: 22px; height: 22px; line-height: 20px; padding: 0;
+  border: 1px solid var(--ad-line); border-radius: 4px;
+  background: var(--ad-s2); color: var(--ad-text); cursor: pointer; font-size: 12px;
+  transition: border-color .18s ease, background .18s ease;
+}
+.im-panels__btn:hover { border-color: var(--ad-accent); background: var(--ad-s3); }
+.im-panels__btn:disabled { opacity: .3; cursor: default; }
+.im-panels__btn:disabled:hover { border-color: var(--ad-line); background: var(--ad-s2); }
+.im-panels .im-item__del { opacity: 1; }
+/* 面板页：移除按钮（点一次变「确认移除？」并标红） */
+/* 新建计划面板：已选文件路径提示 */
+.im-pick__tip { font-family: var(--ad-font); font-size: 11.5px; color: var(--ad-text-mute); flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.im-panel__bar { display: flex; justify-content: flex-end; margin-top: 6px; }
+.im-panel__del.is-danger { border-color: var(--ad-danger); color: var(--ad-danger); }
